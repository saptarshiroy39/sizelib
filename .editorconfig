# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python files
[*.py]
indent_style = space
indent_size = 4
max_line_length = 200

# C / C++ files
[*.{c,h,cpp,hpp,cc,hh,cxx,hxx}]
indent_style = space
indent_size = 2

# JavaScript & TypeScript
[*.{js,jsx,mjs,cjs,ts,tsx}]
indent_style = space
indent_size = 2

# HTML & CSS files
[*.{html,htm,css,scss,sass,less}]
indent_style = space
indent_size = 2

# JSON files
[*.{json,jsonc,json5}]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.{md,mdx}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Configuration & Environment files
[*.{toml,ini,cfg,conf}]
indent_style = space
indent_size = 4

[*.env*]
indent_style = space
indent_size = 4

# Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 2

# PowerShell scripts
[*.{ps1,psm1,psd1}]
indent_style = space
indent_size = 4

# Windows Batch scripts
[*.{bat,cmd}]
indent_style = space
indent_size = 2

# SQL files
[*.sql]
indent_style = space
indent_size = 2

# Hardware Description Languages (VHDL / Verilog)
[*.{vhd,vhdl,v,sv}]
indent_style = space
indent_size = 2

# Scientific / Computing (Scilab / MATLAB)
[*.{sce,sci,m}]
indent_style = space
indent_size = 2

# Logic Programming & Scripting (Prolog / Perl)
[*.{pl,pro}]
indent_style = space
indent_size = 2

# XML & SVG files
[*.{xml,svg,drawio}]
indent_style = space
indent_size = 2

# Jupyter Notebooks
[*.ipynb]
indent_style = space
indent_size = 2

# Dockerfiles
[Dockerfile*]
indent_style = space
indent_size = 2

# Makefiles (tabs are required by Make syntax)
[{Makefile,*.mk}]
indent_style = tab
